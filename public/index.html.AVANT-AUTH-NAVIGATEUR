<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HATIMEDIA IA</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
            background: #f5f7fb;
            color: #1f2937;
        }

        .app {
            width: 100%;
            max-width: 850px;
            height: 90vh;
            margin: 5vh auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .header {
            padding: 20px 25px;
            background: #111827;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 {
            margin: 0;
            font-size: 22px;
        }

        .header span {
            font-size: 13px;
            opacity: 0.7;
        }

        .chat {
            flex: 1;
            padding: 25px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .message {
            max-width: 75%;
            padding: 13px 17px;
            border-radius: 18px;
            line-height: 1.5;
            white-space: pre-wrap;
        }

        .user {
            align-self: flex-end;
            background: #2563eb;
            color: white;
            border-bottom-right-radius: 5px;
        }

        .assistant {
            align-self: flex-start;
            background: #eef2f7;
            color: #1f2937;
            border-bottom-left-radius: 5px;
        }

        .welcome {
            text-align: center;
            margin: auto;
            color: #6b7280;
        }

        .welcome .robot {
            font-size: 55px;
            margin-bottom: 10px;
        }

        .welcome h2 {
            margin: 5px 0;
            color: #111827;
        }

        .input-area {
            padding: 18px;
            border-top: 1px solid #e5e7eb;
            display: flex;
            gap: 10px;
            background: white;
        }

        .input-area input {
            flex: 1;
            padding: 14px 16px;
            border: 1px solid #d1d5db;
            border-radius: 12px;
            font-size: 16px;
            outline: none;
        }

        .input-area input:focus {
            border-color: #2563eb;
        }

        .send {
            border: none;
            background: #2563eb;
            color: white;
            padding: 0 22px;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
        }

        .send:hover {
            background: #1d4ed8;
        }

        .clear {
            border: none;
            background: transparent;
            color: #d1d5db;
            cursor: pointer;
            font-size: 13px;
        }

        .clear:hover {
            color: white;
        }

        @media (max-width: 700px) {
            .app {
                height: 100vh;
                margin: 0;
                border-radius: 0;
            }

            .message {
                max-width: 88%;
            }
        }
    </style>
</head>

<body>

<div class="app">

    <div class="header">
        <div>
            <h1>🤖 HATIMEDIA IA</h1>
            <span>Propulsé par OpenAI</span>
        </div>

        <button class="clear" onclick="effacerConversation()">
            Effacer
        </button>
    </div>

    <div id="chat" class="chat">

        <div id="welcome" class="welcome">
            <div class="robot">🤖</div>

            <h2>Bonjour !</h2>

            <p>
                Je suis votre assistant IA.<br>
                Posez-moi une question pour commencer.
            </p>
        </div>

    </div>

    <div class="input-area">

        <input
            id="message"
            type="text"
            placeholder="Écrivez votre message..."
            autocomplete="off"
        >

        <button class="send" onclick="envoyerMessage()">
            Envoyer
        </button>

    </div>

</div>

<script>

    const input = document.getElementById("message");
    const chat = document.getElementById("chat");

    let conversation = [];


    input.addEventListener("keydown", function(event) {

        if (event.key === "Enter") {
            envoyerMessage();
        }

    });


    function ajouterMessage(texte, type) {

        const message = document.createElement("div");

        message.className = "message " + type;

        message.textContent = texte;

        chat.appendChild(message);

        chat.scrollTop = chat.scrollHeight;

        return message;
    }


    async function envoyerMessage() {

        const message = input.value.trim();

        if (!message) {
            return;
        }


        const welcome = document.getElementById("welcome");

        if (welcome) {
            welcome.remove();
        }


        // Ajouter le message de l'utilisateur à l'écran
        ajouterMessage(message, "user");


        // Ajouter le message de l'utilisateur à la mémoire
        conversation.push({
            role: "user",
            content: message
        });


        input.value = "";


        // Afficher "L'IA réfléchit..."
        const thinking = ajouterMessage(
            "⏳ L'IA réfléchit...",
            "assistant"
        );


        try {

            const response = await fetch("/api/chat", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    messages: conversation
                })

            });


            const data = await response.json();


            thinking.remove();


            if (data.reply) {

                // Afficher la réponse de l'IA
                ajouterMessage(
                    data.reply,
                    "assistant"
                );


                // Ajouter la réponse de l'IA à la mémoire
                conversation.push({
                    role: "assistant",
                    content: data.reply
                });


            } else {

                ajouterMessage(
                    "Une erreur est survenue.",
                    "assistant"
                );

            }


        } catch (error) {

            console.error(error);

            thinking.remove();

            ajouterMessage(
                "Impossible de contacter le serveur.",
                "assistant"
            );

        }


        input.focus();
    }


    function effacerConversation() {

        // Effacer la mémoire
        conversation = [];


        // Réinitialiser l'écran
        chat.innerHTML = `

            <div id="welcome" class="welcome">

                <div class="robot">🤖</div>

                <h2>Bonjour !</h2>

                <p>
                    Je suis votre assistant IA.<br>
                    Posez-moi une question pour commencer.
                </p>

            </div>

        `;

        input.focus();
    }

</script>

</body>
</html>