<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HATIMEDIA IA</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
            background: #f5f7fb;
            color: #1f2937;
        }

        .app {
            width: 100%;
            max-width: 850px;
            height: 90vh;
            margin: 5vh auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .header {
    padding: 22px 28px;
    background: linear-gradient(135deg, #111827, #1e3a8a);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.12);
}

        .header h1 {
            margin: 0;
            font-size: 22px;
        }

        .header span {
            font-size: 13px;
            opacity: 0.7;
        }

        .chat {
            flex: 1;
            padding: 25px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .message {
            max-width: 75%;
            padding: 13px 17px;
            border-radius: 18px;
            line-height: 1.5;
            white-space: pre-wrap;
        }

        .user {
            align-self: flex-end;
            background: #2563eb;
            color: white;
            border-bottom-right-radius: 5px;
        }

        .assistant {
            align-self: flex-start;
            background: #eef2f7;
            color: #1f2937;
            border-bottom-left-radius: 5px;
        }

        .welcome {
            text-align: center;
            margin: auto;
            color: #6b7280;
        }

        .welcome .robot {
            font-size: 55px;
            margin-bottom: 10px;
        }

        .welcome h2 {
            margin: 5px 0;
            color: #111827;
        }

        .input-area {
            padding: 18px;
            border-top: 1px solid #e5e7eb;
            display: flex;
            gap: 10px;
            background: white;
        }

        .input-area input {
            flex: 1;
            padding: 14px 16px;
            border: 1px solid #d1d5db;
            border-radius: 12px;
            font-size: 16px;
            outline: none;
        }

        .input-area input:focus {
            border-color: #2563eb;
        }

        .send {
            border: none;
            background: #2563eb;
            color: white;
            padding: 0 22px;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
        }

        .send:hover {
            background: #1d4ed8;
        }

        .clear {
            border: none;
            background: transparent;
            color: #d1d5db;
            cursor: pointer;
            font-size: 13px;
        }

        .clear:hover {
            color: white;
        }

        @media (max-width: 700px) {
            .app {
                height: 100vh;
                margin: 0;
                border-radius: 0;
            }

            .message {
                max-width: 88%;
            }
        }
    
        body {
            background-image: linear-gradient(
                rgba(5, 5, 20, 0.35),
                rgba(5, 5, 20, 0.55)
            ), none;
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

</style>

<style>
/* ========================================
   HATIMEDIA JOYEUX v1 🎉
   ======================================== */

.hatimedia-celebration {
    position: fixed;
    left: 50%;
    top: 18%;
    transform: translate(-50%, -50%) scale(.85);
    z-index: 99999;
    padding: 14px 24px;
    border-radius: 18px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 12px 40px rgba(0,0,0,.18);
    font-size: 18px;
    font-weight: 700;
    opacity: 0;
    pointer-events: none;
    animation: hatimediaJoy 1.8s ease forwards;
}

@keyframes hatimediaJoy {
    0% {
        opacity: 0;
        transform: translate(-50%, -50%) scale(.75);
    }
    20% {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1.05);
    }
    70% {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
    100% {
        opacity: 0;
        transform: translate(-50%, -50%) scale(.95);
    }
}

.hatimedia-confetti {
    position: fixed;
    top: -20px;
    z-index: 99998;
    pointer-events: none;
    font-size: 20px;
    animation: hatimediaConfetti 1.8s linear forwards;
}

@keyframes hatimediaConfetti {
    0% {
        opacity: 1;
        transform: translateY(0) rotate(0deg);
    }
    100% {
        opacity: 0;
        transform: translateY(105vh) rotate(720deg);
    }
}
</style>

<script>
/* ========================================
   HATIMEDIA JOYEUX v1 🎉
   ======================================== */

function hatimediaCelebrer(message = "Bravo ! C'est fait 🎉") {

    const celebration = document.createElement("div");

    celebration.className = "hatimedia-celebration";
    celebration.textContent = message;

    document.body.appendChild(celebration);

    const symboles = ["🎉", "✨", "🎊", "🥳", "⭐"];

    for (let i = 0; i < 18; i++) {

        const confetti = document.createElement("div");

        confetti.className = "hatimedia-confetti";
        confetti.textContent =
            symboles[Math.floor(Math.random() * symboles.length)];

        confetti.style.left =
            Math.random() * 100 + "vw";

        confetti.style.animationDelay =
            Math.random() * 0.35 + "s";

        document.body.appendChild(confetti);

        setTimeout(() => {
            confetti.remove();
        }, 2300);
    }

    setTimeout(() => {
        celebration.remove();
    }, 2000);
}
</script>


<style id="HATIMEDIA-DESIGN-V3">
/* ========================================
   HATIMEDIA DESIGN V3
   VISUEL UNIQUEMENT — AUCUNE LOGIQUE
   ======================================== */

