<body>

<div id="loginPanel" style="
    position: fixed;
    inset: 0;
    background: #f5f7fb;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
">
    <div style="
        width: 100%;
        max-width: 420px;
        margin: 20px;
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.12);
    ">
        <div style="text-align:center; font-size:50px;">🤖</div>
        <h2 style="text-align:center;">Connexion HATIMEDIA</h2>

        <input
            id="loginEmail"
            type="email"
            placeholder="Votre email"
            autocomplete="email"
            style="
                width:100%;
                padding:14px;
                margin:8px 0;
                border:1px solid #d1d5db;
                border-radius:12px;
                font-size:16px;
            "
        >

        <input
            id="loginPassword"
            type="password"
            placeholder="Votre mot de passe"
            autocomplete="current-password"
            style="
                width:100%;
                padding:14px;
                margin:8px 0;
                border:1px solid #d1d5db;
                border-radius:12px;
                font-size:16px;
            "
        >

        <button
            id="loginButton"
            onclick="connexion()"
            style="
                width:100%;
                padding:14px;
                margin-top:10px;
                border:0;
                border-radius:12px;
                background:#2563eb;
                color:white;
                font-size:16px;
                cursor:pointer;
            "
        >
            Se connecter
        </button>

        <div
            id="loginError"
            style="
                margin-top:12px;
                color:#dc2626;
                text-align:center;
                min-height:20px;
            "
        ></div>
    </div>
</div>

<div class="app">

    <div class="header">
        <div>
            <h1>🤖 HATIMEDIA IA</h1>
            <span>Propulsé par OpenAI</span>
        </div>

        <button class="clear" onclick="effacerConversation()">
            Effacer
        </button>
    </div>

    <div id="chat" class="chat">

    <div id="welcome" class="welcome">

        <div class="welcome-logo">🏰</div>
        <img src="/fond-hatime.png" class="photo-hatime" alt="Hatime">
      

        <h2>Bienvenue sur HATIMEDIA IA 👋🏾</h2> <p> Votre assistant IA personnel pour discuter, analyser, créer et travailler avec vos documents. </p>

        <div class="hatimedia-v2-title">✨ Que voulez-vous faire ?</div>
<style>
.hatimedia-v2-title {
    text-align: center;
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 600;
    color: inherit;
    letter-spacing: .3px;
}
.action-grid {
    gap: 12px !important;
}
.action-card {
    transition: transform .2s ease, box-shadow .2s ease !important;
    cursor: pointer;
}
.action-card:hover {
    transform: translateY(-3px) !important;
    box-shadow: 0 8px 24px rgba(0,0,0,.18) !important;
}
.action-icon {
    display: inline-block;
    transition: transform .2s ease;
}
.action-card:hover .action-icon {
    transform: scale(1.12);
}
</style>
<div class="action-grid">

            <button class="action-card" onclick="document.getElementById('message').focus()">
                <span class="action-icon">💬</span>
                <strong>DISCUTER</strong>
                <small>Parler normalement avec HATIMEDIA</small>
            </button>

            <button class="action-card" onclick="parler()">
                <span class="action-icon">🎙️</span>
                <strong>PARLER</strong>
                <small>Parler avec votre voix</small>
            </button>

            <button class="action-card" onclick="analyser()">
                <span class="action-icon">📄</span>
                <strong>ANALYSER</strong>
                <small>Analyser un document</small>
            </button>

            <button class="action-card" onclick="creer()">
                <span class="action-icon">💡</span>
                <strong>CRÉER</strong>
                <small>Créer des idées avec HATIMEDIA</small>
            </button>

        </div>

    </div>

</div>




<div class="input-area">

    <input
        id="message"
        type="text"
        placeholder="Écrivez votre message..."
        autocomplete="off"
    >

    <button class="send" onclick="envoyerMessage()">
        Envoyer
    </button>

</div>

<script>

    const input = document.getElementById("message");
    const chat = document.getElementById("chat");

    let conversation = [];


    input.addEventListener("keydown", function(event) {

        if (event.key === "Enter") {
            envoyerMessage();
        }

    });


    async function connexion() {

        const email = document.getElementById("loginEmail").value.trim();
        const password = document.getElementById("loginPassword").value;
        const erreur = document.getElementById("loginError");
        const bouton = document.getElementById("loginButton");

        erreur.textContent = "";

        if (!email || !password) {
            erreur.textContent = "Veuillez saisir votre email et votre mot de passe.";
            return;
        }

        bouton.disabled = true;
        bouton.textContent = "Connexion...";

        try {

            const response = await fetch("/api/login", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    email: email,
                    password: password
                })
            });

            const data = await response.json();

            if (!response.ok || !data.token) {
                throw new Error(
                    data.error || "Connexion impossible"
                );
            }

            localStorage.setItem(
                "hatimedia_token",
                data.token
            );

            document.getElementById("loginPanel").style.display = "none";

            input.focus();

        } catch (error) {

            console.error(error);

            erreur.textContent =
                error.message || "Erreur de connexion.";

        } finally {

            bouton.disabled = false;
            bouton.textContent = "Se connecter";

        }
    }


        function ajouterMessage(texte, type) {

        const message = document.createElement("div");

        message.className = "message " + type;

        message.textContent = texte;

        chat.appendChild(message);

        chat.scrollTop = chat.scrollHeight;

        return message;
    }


    async function envoyerMessage() {

        const message = input.value.trim();

        if (!message) {
            return;
        }


        const welcome = document.getElementById("welcome");

        if (welcome) {
            welcome.remove();
        }


        // Ajouter le message de l'utilisateur à l'écran
        ajouterMessage(message, "user");


        // Ajouter le message de l'utilisateur à la mémoire
        conversation.push({
            role: "user",
            content: message
        });


        input.value = "";


        // Afficher "L'IA réfléchit..."
        const thinking = ajouterMessage(
            "⏳ L'IA réfléchit...",
            "assistant"
        );


        try {

            const response = await fetch("/api/chat", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer " + localStorage.getItem("hatimedia_token")
                },

                body: JSON.stringify({
                    messages: conversation
                })

            });


            const data = await response.json();


            thinking.remove();


            if (data.reply) {

                // Afficher la réponse de l'IA
                ajouterMessage(
                    data.reply,
                    "assistant"
                );

                if (
                    typeof data.reply === "string" &&
                    /\b(bravo|félicitations|réussi|réussite|terminé|terminée|fait|parfait|super|excellent|génial)\b/i.test(data.reply)
                ) {
                    
                }


                // Ajouter la réponse de l'IA à la mémoire
                conversation.push({
                    role: "assistant",
                    content: data.reply
                });


            } else {

                ajouterMessage(
                    "Une erreur est survenue.",
                    "assistant"
                );

            }


        } catch (error) {

            console.error(error);

            thinking.remove();

            ajouterMessage(
                "Impossible de contacter le serveur.",
                "assistant"
            );

        }


        input.focus();
    }


    function effacerConversation() {

        // Effacer la mémoire
        conversation = [];


        // Réinitialiser l'écran
        chat.innerHTML = `

            <div id="welcome" class="welcome">

                <div class="robot">🤖</div>

                <h2>Bonjour !</h2>

                <p>
                    Je suis votre assistant IA.<br>
                    Posez-moi une question pour commencer.
                </p>

            </div>

        `;

        input.focus();
    }

</script>

<script>
function parler() {

    if (!("webkitSpeechRecognition" in window) && !("SpeechRecognition" in window)) {
        alert("La reconnaissance vocale n'est pas disponible dans ce navigateur.");
        return;
    }

    const SpeechRecognition =
        window.SpeechRecognition || window.webkitSpeechRecognition;

    const recognition = new SpeechRecognition();

    recognition.lang = "fr-FR";
    recognition.continuous = false;
    recognition.interimResults = false;

    recognition.onstart = function () {
        const bouton = document.querySelector(".action-card:nth-child(2)");
        if (bouton) {
            bouton.querySelector("strong").textContent = "ÉCOUTE...";
        }
    };

    recognition.onresult = function (event) {

        const texte = event.results[0][0].transcript;

        input.value = texte;

        envoyerMessage();

    };

    recognition.onerror = function (event) {

        console.error("Erreur reconnaissance vocale :", event.error);

        alert("Impossible d'utiliser le microphone : " + event.error);

    };

    recognition.onend = function () {

        const bouton = document.querySelector(".action-card:nth-child(2)");

        if (bouton) {
            bouton.querySelector("strong").textContent = "PARLER";
        }

    };

    recognition.start();
}



function analyser() {

    const choixFichier = document.createElement("input");

    choixFichier.type = "file";
    choixFichier.accept = ".pdf,.docx,.txt";

    choixFichier.onchange = async function () {

        if (!choixFichier.files.length) {
            return;
        }

        const fichier = choixFichier.files[0];

        const formulaire = new FormData();

        formulaire.append("document", fichier);

        try {

            const response = await fetch("/api/analyser-document", {
    method: "POST",
    headers: {
        "Authorization": "Bearer " + localStorage.getItem("hatimedia_token")
    },
    body: formulaire
});

            const data = await response.json();

            if (!response.ok || !data.ok) {
                throw new Error(data.error || "Erreur lors de l'envoi");
            }

            window.documentAnalyse = data.text;

           ajouterMessage(
           "📄 Document analysé par HATIMEDIA ✅\n\n" +
           "Fichier : " + data.filename +
           "\n\n" +
           data.analysis,
           "assistant"
           );

           

           } catch (error) {

            console.error(error);

            ajouterMessage(
                "❌ Impossible d'envoyer le document.",
                "assistant"
            );
        }
    };

   

    choixFichier.value = "";
    choixFichier.click();
}




function creer() {
    if (document.querySelector(".hatimedia-create-box")) return;

    const box = document.createElement("div");
    box.className = "hatimedia-create-box";

    box.innerHTML = `
        <div class="hatimedia-create-panel">
            <h3>💡 Créer avec HATIMEDIA</h3>
            <p>Choisissez un type puis décrivez ce que vous voulez créer.</p>

            <div class="hatimedia-create-types">
                <button onclick="choisirCreation('un texte')">✍🏾 Texte</button>
                <button onclick="choisirCreation('une idée')">💡 Idée</button>
                <button onclick="choisirCreation('une publication pour les réseaux sociaux')">📱 Publication</button>
                <button onclick="choisirCreation('un email')">📧 Email</button>
            </div>

            <textarea id="hatimediaCreatePrompt"
                placeholder="Exemple : présente HATIMEDIA en quelques lignes..."></textarea>

            <div class="hatimedia-create-actions">
                <button class="annuler" onclick="fermerCreation()">Annuler</button>
                <button class="generer" onclick="genererCreation()">✨ Générer</button>
            </div>
        </div>
    `;

    document.body.appendChild(box);
    document.getElementById("hatimediaCreatePrompt").focus();
}

function choisirCreation(type) {
    const zone = document.getElementById("hatimediaCreatePrompt");
    if (zone) {
        zone.value = "Crée " + type + " : ";
        zone.focus();
    }
}

function fermerCreation() {
    const box = document.querySelector(".hatimedia-create-box");
    if (box) box.remove();
}

async function genererCreation() {
    const zone = document.getElementById("hatimediaCreatePrompt");
    const prompt = zone ? zone.value.trim() : "";

    if (!prompt) {
        alert("Écrivez d'abord ce que vous voulez créer.");
        return;
    }

    const token = localStorage.getItem("hatimedia_token");

    if (!token) {
        alert("Votre session HATIMEDIA a expiré. Veuillez vous reconnecter.");
        return;
    }

    const bouton = document.querySelector(".hatimedia-create-actions .generer");

    if (bouton) {
        bouton.disabled = true;
        bouton.textContent = "⏳ Génération...";
    }

    try {
        const response = await fetch("/api/chat", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Authorization": "Bearer " + token
            },
            body: JSON.stringify({
                messages: [
                    {
                        role: "user",
                        content: prompt
                    }
                ]
            })
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || "Erreur lors de la génération");
        }

        fermerCreation();

        ajouterMessage(
            "💡 Création HATIMEDIA\n\n" +
            (data.reply || "Création terminée."),
            "assistant"
        );

    } catch (error) {
        console.error(error);
        alert("Impossible de générer le contenu : " + error.message);

        if (bouton) {
            bouton.disabled = false;
            bouton.textContent = "✨ Générer";
        }
    }
}

</script>

</body>
</html>
<style>
/* HATIMEDIA CLEAN — étoiles/confettis désactivés */
.hatimedia-confetti {
    display: none !important;
}
</style>
