// ========================================
// RÉCEPTION DES MESSAGES MESSENGER
// ========================================

app.post("/webhook", async (req, res) => {

    console.log("📩 WEBHOOK META REÇU");

    console.log(
        JSON.stringify(req.body, null, 2)
    );

    // Répondre immédiatement à Meta

    res.sendStatus(200);

    try {

        if (req.body.object !== "page") {
            return;
        }

        for (const entry of req.body.entry || []) {

            for (const event of entry.messaging || []) {

                const senderId = event.sender?.id;

                const messageText = event.message?.text;

                // Ignorer les événements sans message texte

                if (!senderId || !messageText) {
                    continue;
                }

                console.log(
                    "👤 Message Messenger :",
                    messageText
                );

                console.log(
                    "🆔 Sender ID :",
                    senderId
                );

                // ========================================
                // OPENAI / HATIMEDIA
                // ========================================

                const response =
                    await client.responses.create({

                        model: "gpt-5",

                        instructions:
                            "Tu es HATIMEDIA, un assistant IA personnel. " +
                            "Réponds en français de manière naturelle, claire et chaleureuse.",

                        input: messageText
                    });

                const reply = response.output_text;

                console.log(
                    "🤖 Réponse HATIMEDIA :",
                    reply
                );

                // ========================================
                // ENVOI DE LA RÉPONSE À MESSENGER
                // ========================================

                const data = JSON.stringify({

                    recipient: {
                        id: senderId
                    },

                    messaging_type: "RESPONSE",

                    message: {
                        text: reply
                    }
                });

                const options = {

                    hostname: "graph.facebook.com",

                    path:
                        "/v26.0/me/messages?access_token=" +
                        encodeURIComponent(
                            process.env.PAGE_ACCESS_TOKEN
                        ),

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json",

                        "Content-Length":
                            Buffer.byteLength(data)
                    }
                };

                const request =
                    https.request(
                        options,
                        responseMeta => {

                            let body = "";

                            responseMeta.on(
                                "data",
                                chunk => {
                                    body += chunk;
                                }
                            );

                            responseMeta.on(
                                "end",
                                () => {

                                    console.log(
                                        "📤 Réponse envoyée à Messenger :",
                                        responseMeta.statusCode,
                                        body
                                    );
                                }
                            );
                        }
                    );

                request.on(
                    "error",
                    error => {

                        console.error(
                            "❌ Erreur envoi Messenger :",
                            error.message
                        );
                    }
                );

                request.write(data);

                request.end();
            }
        }

    } catch (error) {

        console.error(
            "❌ Erreur HATIMEDIA Messenger :",
            error
        );
    }
});

