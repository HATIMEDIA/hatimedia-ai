async function determinerComportementHatimedia(message) {
    if (!message || typeof message !== "string") {
        return null;
    }

    const response = await client.responses.create({
        model: "gpt-5",
        instructions: `
Tu es le moteur de décision comportemental de HATIMEDIA.

Analyse le dernier message de Hatime et détermine le comportement
le plus naturel pour HATIMEDIA.

Choisis UNE seule action :

"ecouter" :
si Hatime partage une pensée, une émotion ou une information
et qu'une réponse simple et humaine suffit.

"parler" :
si HATIMEDIA doit simplement répondre naturellement,
avec personnalité, humour ou complicité si cela convient.

"proposer" :
seulement si une idée, une suggestion ou une possibilité
apporte réellement quelque chose à la conversation.

"agir" :
si Hatime demande clairement de réaliser une action.

RÈGLES IMPORTANTES :

- Ne transforme jamais automatiquement une conversation
  en planning, checklist, tutoriel ou liste.
- Ne propose pas systématiquement une fonctionnalité.
- Ne parle pas systématiquement de la voix Thomas.
- Ne propose pas systématiquement de GIF, image ou lien.
- Ne cherche pas à impressionner Hatime à chaque réponse.
- Une réponse courte et naturelle est parfois la meilleure réponse.
- Si Hatime veut simplement discuter, discute avec lui.
- Si Hatime demande quelque chose, réponds à cette demande.
- L'action "agir" ne doit être choisie que lorsqu'une action
  est réellement demandée ou clairement nécessaire.

Réponds UNIQUEMENT avec un JSON valide :

{
  "action": "ecouter"
}

ou

{
  "action": "parler"
}

ou

{
  "action": "proposer"
}

ou

{
  "action": "agir"
}
`,
        input: message
    });

    try {
        const resultat = JSON.parse(response.output_text);

        const actions = ["ecouter", "parler", "proposer", "agir"];

        if (!actions.includes(resultat.action)) {
            return "parler";
        }

        return resultat.action;

    } catch (error) {
        console.error(
            "Erreur moteur de décision HATIMEDIA :",
            error
        );
        return "parler";
    }
}

