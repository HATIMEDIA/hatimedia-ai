async function determinerEvolutionSouvenir(ancienSouvenir, nouveauSouvenir) {

    if (
        !ancienSouvenir ||
        typeof ancienSouvenir !== "string" ||
        !nouveauSouvenir ||
        typeof nouveauSouvenir !== "string"
    ) {
        return null;
    }

    const response = await client.responses.create({
        model: "gpt-5",

        instructions: `
Tu compares deux souvenirs personnels déjà détectés
par HATIMEDIA.

Ton objectif est de déterminer s'ils représentent
la même information durable.

Règles :

- sameMemory = true si le nouveau souvenir reformule,
  précise ou actualise essentiellement la même information.

- sameMemory = false si le nouveau souvenir apporte
  une information différente, même si les deux souvenirs
  parlent du même sujet.

Exemples :

Ancien :
"L'utilisateur préfère travailler avec HATIMEDIA étape par étape."

Nouveau :
"Préfère travailler toujours étape par étape sur HATIMEDIA."

=> sameMemory = true

Ancien :
"L'utilisateur préfère travailler avec HATIMEDIA étape par étape."

Nouveau :
"L'utilisateur aime travailler avec HATIMEDIA."

=> sameMemory = false

Réponds UNIQUEMENT avec un JSON valide :

{
  "sameMemory": true
}

ou :

{
  "sameMemory": false
}
`,

        input: `
ANCIEN SOUVENIR :
${ancienSouvenir}

NOUVEAU SOUVENIR :
${nouveauSouvenir}
`
    });

    try {

        const resultat = JSON.parse(response.output_text);

        return {
            sameMemory: resultat.sameMemory === true
        };

    } catch (error) {

        console.error(
            "Erreur lors de la décision d'évolution :",
            error
        );

        return null;
    }
}




async function formulerNouvelleMemoire(ancienSouvenir, nouveauSouvenir) {

    if (
        !ancienSouvenir ||
        typeof ancienSouvenir !== "string" ||
        !nouveauSouvenir ||
        typeof nouveauSouvenir !== "string"
    ) {
        return null;
    }

    const response = await client.responses.create({
        model: "gpt-5",

        instructions: `
Tu fais évoluer une mémoire personnelle de HATIMEDIA.

Tu reçois deux formulations qui représentent la même
information durable.

Ton objectif est de produire une formulation canonique,
courte, claire et fidèle à l'information la plus récente.

Règles :

- conserve uniquement l'information durable ;
- intègre les précisions apportées par le nouveau souvenir ;
- ne rajoute aucune information absente des deux souvenirs ;
- écris à la troisième personne ;
